# Variáveis de ambiente do frontend (Vite)
# Copie para .env e preencha com seus valores reais.

# Supabase (obrigatório para produção)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# As funções Supabase usam estas variáveis no servidor (não prefixe com VITE_):
SUPABASE_SERVICE_ROLE_KEY=
EVOPAY_API_KEY=
EVOPAY_WEBHOOK_SECRET=
EVOPAY_WEBHOOK_URL=
EVOPAY_CREATE_CHARGE_PATH=
APP_ORIGIN=
RESEND_API_KEY=

# Apenas variáveis VITE_* chegam ao navegador.
# Nunca coloque service_role, gateway, Resend, Cloudflare ou outras secrets no frontend.
