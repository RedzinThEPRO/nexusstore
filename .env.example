# Variáveis de ambiente do frontend (Vite)
# Copie para .env e preencha com seus valores reais.

# Supabase (obrigatório para produção)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gateway de Pagamento (PIX)
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# IA
AI_API_KEY=

# E-mail (Resend)
RESEND_API_KEY=

# Nunca coloque senhas, tokens ou credenciais administrativas no frontend.
# Crie usuários e configure MFA exclusivamente no Supabase Auth.
